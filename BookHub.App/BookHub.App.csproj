<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BookHub.Core\BookHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AllReaderBook.ico" />
    <Resource Include="Assets\bookhub.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>ReaderHub</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AllReaderBook.ico</ApplicationIcon>
    <AssemblyTitle>ReaderHub — High-Speed Book Cataloger &amp; PDFium Reader</AssemblyTitle>
    <Product>ReaderHub</Product>
    <Version>3.62.0</Version>
    <AssemblyVersion>3.62.0.0</AssemblyVersion>
    <FileVersion>3.62.0.0</FileVersion>
    <InformationalVersion>3.62</InformationalVersion>
  </PropertyGroup>

</Project>
