<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BookHub.Core\BookHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\bookhub.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\bookhub.ico</ApplicationIcon>
    <AssemblyTitle>BookHub Pro — High-Speed Book Cataloger &amp; PDFium Reader</AssemblyTitle>
    <Product>BookHub Pro</Product>
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>
