<Window x:Class="BookHub.App.Views.WelcomeWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BookHub.App.ViewModels"
        Title="BookHub Pro — Майстер першого запуску"
        Width="840" Height="575"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        PreviewDragOver="FoldersDropZone_PreviewDragOver"
        Drop="FoldersDropZone_Drop">
    <Border BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            Background="{DynamicResource BgPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Custom Draggable Header with Step Progress Indicator (1 — 2 — 3 — 4 — 5) & Subtle Skip Button -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0">
                            <TextBlock Text="📚" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BookHub Pro" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="First-Run Setup Wizard" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step Progress Carousel Pills (1 — 2 — 3 — 4 — 5) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="1" Width="30" Height="30" Padding="0" FontWeight="Bold" Command="{Binding GoToStepCommand}" CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="22" Height="2" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="4,0" />

                        <Button Content="2" Width="30" Height="30" Padding="0" FontWeight="Bold" Command="{Binding GoToStepCommand}" CommandParameter="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="22" Height="2" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="4,0" />

                        <Button Content="3" Width="30" Height="30" Padding="0" FontWeight="Bold" Command="{Binding GoToStepCommand}" CommandParameter="3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="22" Height="2" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="4,0" />

                        <Button Content="4" Width="30" Height="30" Padding="0" FontWeight="Bold" Command="{Binding GoToStepCommand}" CommandParameter="4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="22" Height="2" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="4,0" />

                        <Button Content="5" Width="30" Height="30" Padding="0" FontWeight="Bold" Command="{Binding GoToStepCommand}" CommandParameter="5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Top-Right Subtle Skip Button -->
                    <Button Grid.Column="2"
                            Content="{DynamicResource Loc_Wiz_SkipBtn}"
                            Command="{Binding SkipWizardCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11.5"
                            Padding="10,5"
                            Opacity="0.82"
                            ToolTip="Пропустити майстер та відкрити бібліотеку зі стандартними налаштуваннями" />
                </Grid>
            </Border>

            <!-- Row 1: Step Carousel Pages -->
            <Grid Grid.Row="1" Margin="28,20,28,16">

                <!-- ==================== STEP 1: WELCOME & LANGUAGE (10 LANGUAGES) ==================== -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20,16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" Width="62" Height="62" CornerRadius="14" Margin="0,0,18,0">
                                <TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="BookHub Pro v3.5" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Wiz_Slogan}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step1Title}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step1Desc}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- 10 Languages Grid (5x2) -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding LanguageCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardLanguageCard}">
                                <Button Margin="4"
                                        Padding="10,10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Code}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlagEmoji}" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding NativeTitle}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ==================== STEP 2: THEME (4 PRESETS + 10 DROPDOWN) & DENSITY ==================== -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step2Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step2ThemeHint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- 4 Featured Theme Cards with Color Swatches -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FeaturedThemeCards}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardThemeCard}">
                                <Button Margin="4"
                                        Padding="12,12"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ThemeName}">
                                    <StackPanel>
                                        <!-- Color Circles Swatch Preview -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Ellipse Width="24" Height="24" Fill="{Binding BgPreviewBrush}" Stroke="#6B7280" StrokeThickness="1" Margin="0,0,5,0" />
                                            <Ellipse Width="24" Height="24" Fill="{Binding CardPreviewBrush}" Stroke="#6B7280" StrokeThickness="1" Margin="0,0,5,0" />
                                            <Ellipse Width="24" Height="24" Fill="{Binding AccentPreviewBrush}" Stroke="#6B7280" StrokeThickness="1" Margin="0,0,5,0" />
                                            <Ellipse Width="24" Height="24" Fill="{Binding TextPreviewBrush}" Stroke="#6B7280" StrokeThickness="1" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- All 10 Themes Quick Selector Row -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="4,0,4,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Повний список із 10 колірних схем BookHub Pro:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AllThemeNames}"
                                      SelectedItem="{Binding SelectedThemeName}"
                                      Padding="8,4" />
                        </Grid>
                    </Border>

                    <!-- Default Catalog Density Mode (Grid vs Table) -->
                    <StackPanel Grid.Row="3" Margin="4,0">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step2DensityLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <RadioButton GroupName="DensityGroup"
                                         IsChecked="{Binding IsGridViewMode}"
                                         Margin="0,0,8,0"
                                         Cursor="Hand">
                                <Border Background="{DynamicResource BgSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Width="345">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_Wiz_GridModeTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Wiz_GridModeDesc}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </RadioButton>

                            <RadioButton GroupName="DensityGroup"
                                         IsChecked="{Binding IsTableViewMode}"
                                         Margin="8,0,0,0"
                                         Cursor="Hand">
                                <Border Background="{DynamicResource BgSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Width="345">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_Wiz_TableModeTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Wiz_TableModeDesc}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- ==================== STEP 3: STORAGE & WATCH-FOLDERS (WITH DRAG & DROP) ==================== -->
                <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step3Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step3Desc}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Add Folder Bar & Drag-and-Drop Hint -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,7"
                                Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Loc_Wiz_DragDropHint}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{DynamicResource Loc_Wiz_AddFolderBtn}"
                                Command="{Binding BrowseAndAddFolderCommand}"
                                Padding="14,7" />
                    </Grid>

                    <!-- Folders ListBox (Supports Drag & Drop) -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,12"
                            AllowDrop="True"
                            PreviewDragOver="FoldersDropZone_PreviewDragOver"
                            Drop="FoldersDropZone_Drop">
                        <ListBox ItemsSource="{Binding SelectedFolders}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,7"
                                            Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StringFormat='📁 {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Padding="8,2"
                                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Formats & Background FileSystemWatcher CheckBoxes -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_Wiz_FormatsLabel}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <CheckBox Content="{DynamicResource Loc_Wiz_CheckEbooks}"
                                      IsChecked="{Binding ScanEbooksEnabled}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="12.5"
                                      Margin="0,0,0,5" />
                            <CheckBox Content="{DynamicResource Loc_Wiz_CheckDocs}"
                                      IsChecked="{Binding ScanDocumentsEnabled}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="12.5"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="{DynamicResource Loc_Wiz_CheckWatcher}"
                                      IsChecked="{Binding EnableBackgroundFileWatcher}"
                                      Foreground="{DynamicResource AccentBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="12.5" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== STEP 4: STORAGE LOCATION & PRIVACY ==================== -->
                <Grid Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step4Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Portable vs Standard Storage Mode Cards -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <RadioButton GroupName="StorageModeGroup"
                                     IsChecked="{Binding IsPortableStorageMode}"
                                     Margin="0,0,0,10"
                                     Cursor="Hand">
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Width="740">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_Wiz_PortableTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Loc_Wiz_PortableDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </RadioButton>

                        <RadioButton GroupName="StorageModeGroup"
                                     IsChecked="{Binding IsStandardStorageMode}"
                                     Cursor="Hand">
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Width="740">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_Wiz_StandardTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Loc_Wiz_StandardDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                    </StackPanel>

                    <!-- Active Database & Cache Paths Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Активні шляхи збереження даних:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                                <Run Text="• Локальна база даних SQLite (FTS5): " FontWeight="SemiBold" />
                                <Run Text="{Binding ActiveDatabasePathPreview, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="• Локальний кеш мініатюр обкладинок: " FontWeight="SemiBold" />
                                <Run Text="{Binding ActiveCachePathPreview, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 100% Offline Privacy Banner -->
                    <Border Grid.Row="3"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="#10B981"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="16,14">
                        <TextBlock Text="{DynamicResource Loc_Wiz_PrivacyBanner}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#10B981"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- ==================== STEP 5: READY TO GO & SUMMARY CARD ==================== -->
                <Grid Visibility="{Binding IsStep5, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step5Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Wiz_Step5Desc}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Configuration Summary Card -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20,16"
                            Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📋 Підсумкова конфігурація BookHub Pro" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Мова інтерфейсу:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryLanguageText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Колірна схема:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryThemeText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Щільність каталогу:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryDensityText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Джерела бібліотеки:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryFoldersText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryFoldersText}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Формати для сканування:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryFormatsText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Режим збереження БД і кешу:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryStorageModeText}" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Large Launch CTA Button -->
                    <Button Grid.Row="2"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{DynamicResource Loc_Wiz_FinishBtn}"
                            Command="{Binding FinishWizardCommand}"
                            FontSize="15.5"
                            Padding="24,13"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Grid>

            <!-- Row 2: Bottom Navigation Bar (Back / Next / Finish) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentStep, StringFormat='Крок {0} із 5'}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Content="{DynamicResource Loc_Wiz_BackBtn}"
                                Command="{Binding PreviousStepCommand}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="115"
                                Margin="0,0,10,0" />

                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{DynamicResource Loc_Wiz_NextBtn}"
                                Command="{Binding NextStepCommand}"
                                Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="130" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
