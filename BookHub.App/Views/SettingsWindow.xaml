<Window x:Class="BookHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_SettingsTitle}"
        Icon="pack://application:,,,/Assets/AllReaderBook.ico"
        Width="780" Height="680"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Language Selector Bar (2-Column Grid with TextWrapping="Wrap" on left & Width="220" ComboBox on right) -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Loc_LanguageLabel}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Loc_LanguageHint}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SelectedLanguageOption}"
                          DisplayMemberPath="DisplayName"
                          Width="220"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Padding="10,6" />
            </Grid>
        </Border>

        <!-- Row 1: Managed Library (\libofbooks) Option -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,12">
            <StackPanel>
                <CheckBox IsChecked="{Binding IsManagedLibraryEnabled}"
                          VerticalContentAlignment="Top"
                          Cursor="Hand">
                    <StackPanel Margin="6,-2,0,0">
                        <TextBlock Text="Бажаєте створити бібліотеку?"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Після увімкнення цієї опції копії усіх знайдених книг будуть скопійовані або перенесені (в залежності від стану відповідного перемикача) до папки \libofbooks"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </CheckBox>

                <!-- Copy vs Move Switch + Custom Path Selector -->
                <Grid Margin="22,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Switch: Copy vs Move -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Режим наповнення \libofbooks:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <RadioButton GroupName="ManagedLibTransferMode"
                                     Content="📋 Скопіювати книги (залишити оригінали)"
                                     IsChecked="{Binding IsManagedLibraryCopyMode}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"
                                     Cursor="Hand"
                                     Margin="0,0,18,0" />
                        <RadioButton GroupName="ManagedLibTransferMode"
                                     Content="✂ Перенести книги до \libofbooks"
                                     IsChecked="{Binding ManagedLibraryMoveFiles}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"
                                     Cursor="Hand" />
                    </StackPanel>

                    <!-- Custom Path on Any Drive for \libofbooks -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Шлях до \libofbooks:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding ResolvedManagedLibraryPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 MinHeight="30"
                                 Padding="8,4"
                                 FontSize="12"
                                 ToolTip="{Binding ResolvedManagedLibraryPath}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="📁 Власний шлях..."
                                ToolTip="Вказати власний шлях на будь-якому диску для створення папки бібліотеки libofbooks"
                                Command="{Binding BrowseManagedLibraryPathCommand}"
                                Padding="10,4"
                                MinHeight="30"
                                Margin="8,0,0,0" />

                        <Button Grid.Column="3"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="↺ За замовч."
                                ToolTip="Скинути до стандартної папки поряд із ReaderHub.exe (\libofbooks)"
                                Command="{Binding ResetManagedLibraryPathCommand}"
                                Padding="8,4"
                                MinHeight="30"
                                Margin="6,0,0,0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Root Folders Header -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc_RootFoldersHeader}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Loc_RootFoldersHint}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 3: Add Folder Bar (Path Input + [+ Додати] + [📁 Огляд...]) -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <TextBox x:Name="FolderPathBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding NewFolderPathInput, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34"
                         Padding="10,6"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Введіть шлях до папки з книгами..."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FolderPathBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="105"
                    MinHeight="34"
                    Padding="12,6"
                    Foreground="#FFFFFF"
                    Style="{StaticResource ModernButtonStyle}"
                    Content="{DynamicResource Loc_AddPath}"
                    Command="{Binding AddManualFolderCommand}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    MinWidth="115"
                    MinHeight="34"
                    Padding="12,6"
                    Foreground="#FFFFFF"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{DynamicResource Loc_BrowseFolders}"
                    Command="{Binding BrowseAndAddFolderCommand}" />
        </Grid>

        <!-- Row 4: Folders List with [🗑 Видалити] Button in Each Row -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ListBox ItemsSource="{Binding RootFolders}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding AddedAt, StringFormat='Додано: {0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Content="{DynamicResource Loc_Remove}"
                                        MinWidth="105"
                                        MinHeight="32"
                                        Padding="12,6"
                                        Foreground="#FFFFFF"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Row 5: Storage Paths Info -->
        <Border Grid.Row="5"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="База даних SQLite: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Run Text="{Binding DatabasePathInfo, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
                    <Run Text="Локальний кеш обкладинок: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Run Text="{Binding CachePathInfo, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Row 6: Bottom Save & Close Button (Height="36", MinWidth="160", HorizontalAlignment="Right", White Text) -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Button Style="{StaticResource AccentButtonStyle}"
                    Content="{DynamicResource Loc_Close}"
                    Height="36"
                    MinHeight="36"
                    MinWidth="160"
                    Padding="18,6"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
