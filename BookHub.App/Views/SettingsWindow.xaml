<Window x:Class="BookHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_SettingsTitle}"
        Width="740" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Language Selector Bar (2-Column Grid with TextWrapping="Wrap" on left & Width="220" ComboBox on right) -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Loc_LanguageLabel}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Loc_LanguageHint}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SelectedLanguageOption}"
                          DisplayMemberPath="DisplayName"
                          Width="220"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Padding="10,6" />
            </Grid>
        </Border>

        <!-- Row 1: Root Folders Header -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Loc_RootFoldersHeader}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Loc_RootFoldersHint}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 2: Add Folder Bar (Path Input + [+ Додати] + [📁 Огляд...]) -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <TextBox x:Name="FolderPathBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding NewFolderPathInput, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="34"
                         Padding="10,6"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Введіть шлях до папки з книгами..."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FolderPathBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="105"
                    MinHeight="34"
                    Padding="12,6"
                    Foreground="#FFFFFF"
                    Style="{StaticResource ModernButtonStyle}"
                    Content="{DynamicResource Loc_AddPath}"
                    Command="{Binding AddManualFolderCommand}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    MinWidth="115"
                    MinHeight="34"
                    Padding="12,6"
                    Foreground="#FFFFFF"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{DynamicResource Loc_BrowseFolders}"
                    Command="{Binding BrowseAndAddFolderCommand}" />
        </Grid>

        <!-- Row 3: Folders List with [🗑 Видалити] Button in Each Row -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ListBox ItemsSource="{Binding RootFolders}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding AddedAt, StringFormat='Додано: {0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Content="{DynamicResource Loc_Remove}"
                                        MinWidth="105"
                                        MinHeight="32"
                                        Padding="12,6"
                                        Foreground="#FFFFFF"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Row 4: Storage Paths Info -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="База даних SQLite: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Run Text="{Binding DatabasePathInfo, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
                    <Run Text="Локальний кеш обкладинок: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Run Text="{Binding CachePathInfo, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Row 5: Bottom Save & Close Button (Height="36", MinWidth="160", HorizontalAlignment="Right", White Text) -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Button Style="{StaticResource AccentButtonStyle}"
                    Content="{DynamicResource Loc_Close}"
                    Height="36"
                    MinHeight="36"
                    MinWidth="160"
                    Padding="18,6"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
