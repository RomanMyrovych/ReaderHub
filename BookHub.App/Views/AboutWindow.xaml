<Window x:Class="BookHub.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_AboutTitle}"
        Icon="pack://application:,,,/Assets/AllReaderBook.ico"
        Width="740" Height="610"
        MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Width="50" Height="50" CornerRadius="10" Margin="0,0,14,0">
                <Image Source="pack://application:,,,/Assets/AllReaderBook.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ReaderHub (Open-Source / Freeware)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3.65-beta" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Нативний каталогізатор та потоковий рідер (C# / .NET 9 WPF / PDFium / SQLite FTS5)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Developer Information Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Автор:"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Roman Myrovych"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="E-mail:"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="20,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           FontSize="12.5"
                           VerticalAlignment="Center">
                    <Hyperlink NavigateUri="mailto:myrovych.roman@ukr.net"
                               Foreground="{DynamicResource AccentBrush}"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="myrovych.roman@ukr.net" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Legal Disclaimer Box -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Ліцензія MIT та Відмова від відповідальності (AS IS Disclaimer)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="ПЗ надається за принципом «AS IS», без будь-яких гарантій, явних чи непрямих. Автори та правовласники не несуть відповідальності за будь-які претензії, збитки чи інші зобов'язання."
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButtonStyle}" Content="📄 Відкрити LICENSE (MIT)" Click="OpenLicenseButton_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource ModernButtonStyle}" Content="📋 Відкрити THIRD_PARTY_LICENSES.txt" Click="OpenThirdPartyButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- License & Third-Party Notices Viewer -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <TextBox x:Name="LicensesTextBox"
                     IsReadOnly="True"
                     Background="Transparent"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas, Segoe UI"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="100% Автономне ПЗ • Без телеметрії • Без використання системного диска C:\" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="Закрити" Width="110" HorizontalAlignment="Right" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
